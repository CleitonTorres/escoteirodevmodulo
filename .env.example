DB_NAME=trilha_digital
URL_DB="mongodb://usuario:senha@127.0.0.1:27017/?authSource=admin"
# DB_PASS pode continuar no seu .env. O driver usa as credenciais de URL_DB.
DB_PASS=

# Confirmação de cadastro e recuperação de senha
# Com SMTP_HOST=smtp.resend.com e SMTP_USER=resend, o envio usa HTTPS e a chave em SMTP_PASS.
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Opcional. Somente um cabeçalho de IP sobrescrito pelo seu proxy reverso.
AUTH_CLIENT_IP_HEADER=

# Upload de imagens e PDFs pelo servidor
BUCKET_NAME=
DESTINATION_FOLDER=
URL_FILES_APLOAD=
AUTORIZATION_TOKEN_COQUEIRAL=

# Dicas do Devinho. Chave privada usada pelo servidor.
OPENAI_API_KEY=
DEVINHO_MONTHLY_REQUESTS=400

# Opcional. Faturamento oficial do projeto no painel administrativo.
OPENAI_ADMIN_KEY=
OPENAI_PROJECT_ID=

# Opcional. Cotação manual em R$ por dólar para o painel do Devinho.
DEVINHO_USD_BRL=
# Origens HTTPS opcionais para imagens de teoria, separadas por vírgula.
# O bucket configurado em BUCKET_NAME também é aceito em storage.googleapis.com.
THEORY_IMAGE_ORIGINS=
