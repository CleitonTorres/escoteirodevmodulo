DB_NAME=trilha_digital
URL_DB="mongodb://usuario:senha@127.0.0.1:27017/?authSource=admin"
# DB_PASS pode continuar no seu .env. O driver usa as credenciais de URL_DB.
DB_PASS=

# Recuperação de senha
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Opcional. Somente um cabeçalho de IP sobrescrito pelo seu proxy reverso.
AUTH_CLIENT_IP_HEADER=
